{
  "name": "metrological-cbor-validator",
  "version": "1.0.0",
  "description": "A static single-page validator for Metrological CBOR (CBOR tag 44252): decode CBOR to a parse tree and JSON, or build CBOR from JSON with reading-like strings converted to metrological values.",
  "private": true,
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch"
  },
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@vanaheimr/cose": "^0.9.0",
    "@vanaheimr/metrological-cbor": "^0.11.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "@vanaheimr/cose": {
      "@vanaheimr/metrological-cbor": "$@vanaheimr/metrological-cbor"
    }
  }
}
